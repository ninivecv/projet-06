```{r}
#| fig-width: 9
#| fig-height: 4.8
#| out-width: 100%
#| echo: FALSE

donnees_graphique <- donnees %>%
  filter(
    !is.na(budget),
    !is.na(gross),
    budget > 0,
    gross >= 0
  ) %>%
  mutate(
    budget_million = budget / 1000000,
    multiplicateur = gross / budget,

    tranche = cut(
      budget_million,
      breaks = c(0, 10, 30, 80, Inf),
      labels = c("< 10 M$", "10–30 M$", "30–80 M$", "≥ 80 M$"),
      right = FALSE
    ),

    rentabilite = case_when(
      multiplicateur < 1 ~ "Perte",
      multiplicateur < 2.5 ~ "Remboursé",
      multiplicateur <= 10 ~ "Rentable",
      multiplicateur > 10 ~ "Gros succès"
    ))

    
  donnees_graphique %>%
  count(tranche, rentabilite) %>%
  ggplot(aes(x = tranche, y = n, fill = rentabilite)) +
    geom_col(position = "fill") +
  scale_y_continuous(
    labels = scales::percent_format(),
    breaks = seq(0, 1, by = 0.1)
  ) +
    scale_fill_manual(
  values = c(
    "Perte" = "firebrick2",
    "Remboursé" = "gold1",
    "Rentable" = "green3",
    "Gros succès" = "deepskyblue1"
  )
)+
  labs(
    title = "Rentabilité des films selon leur budget",
    subtitle = "Rentable: recettes entre 2,5 et 10x le budget , Gros succès: recettes 10x et plus le budget",
    x = "Tranche de budget",
    y = "Pourcentage de films",
    fill = "Rentabilité"
  ) +
    theme_minimal()+
    theme(legend.position = "bottom",
          plot.title = element_text(hjust = 0.5,size = 16),
          plot.subtitle = element_text(hjust = 0.5,size = 10),
          axis.title = element_text(size = 12),
          axis.text = element_text(size = 10))
    
  

       )

donnees_propres <- donnees %>%
  filter(
    if_all(c(budget, gross, score,genre), ~ !is.na(.)))
  
 donnees_propres <- donnees_propres %>%
   mutate(budget_million = budget/1000000,
         gross_million = gross/1000000,
         ROI = if_else(
  budget_million > 0,
  round((gross_million - budget_million) / budget_million, 2),
  NA_real_),
  multiple = gross_million/budget_million,
  rentable = multiple >= 2.5,
          budget_million = round(budget_million),
         gross_million = round(gross_million,2),
         tranche = cut(budget_million, c(0, 10, 30, 80, Inf),
                  labels = c("< 10 M$", "10–30 M$", "30–80 M$", "> 80 M$")),)%>%
  select(name, budget_million, gross_million, score,ROI,tranche,rentable) %>%
  arrange(desc(budget_million))
  

  



  

 




         
      
